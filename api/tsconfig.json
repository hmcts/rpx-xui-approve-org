{
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "../dist/organisation-manager",
        "module": "commonjs",
        "target": "es2022",
        "types": [
            "node",
            "mocha"
        ],
        "paths": {
            "otp": [
                "../node_modules/otp/dist/otp.d.ts"
            ],
            "models/*": [
                "./models/*"
            ]
        },
        "lib": [
            "es2022",
            "dom"
        ],
        "moduleResolution": "node10",
        "strict": false,
        "rootDir": "..",
        "esModuleInterop": false,
        "ignoreDeprecations": "6.0",
        "useDefineForClassFields": false
    },
    "include": [
        "**/*.ts",
        "../*.ts"
    ],
    "exclude": [
        "**/*.spec.ts"
    ]
}
