{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "importHelpers": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "skipLibCheck": true,
    "paths": {
      "otp": [
        "./node_modules/otp/dist/otp.d.ts"
      ],
      "src/*": [
        "./src/*"
      ]
    },
    "useDefineForClassFields": false,
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": false,
    "rootDir": "."
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node10",
      "esModuleInterop": false,
      "ignoreDeprecations": "6.0"
    }
  }
}
