{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config"
  ],
  "automerge": true,
  "automergeSchedule": [
    "* 8-9 * * 1-4"
  ],
  "platformAutomerge": false,
  "timezone": "Europe/London",
  "schedule": [
    "* 7 * * 1-4"
  ],
  "updateNotScheduled": false,
  "packageRules": [
    {
      "description": "Disable major version updates",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
