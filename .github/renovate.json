{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-all"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "timezone": "Europe/London",
  "schedule": ["* 7-16 * * 1-4"],
  "automergeSchedule": ["* 7-16 * * 1-4"],
  "updateNotScheduled": false,
  "packageRules": [
    {
      "description": "Exclude pinned HMCTS and Angular dependencies from Renovate updates",
      "matchPackageNames": [
        "@hmcts/ccd-case-ui-toolkit",
        "@hmcts/ccpay-web-component",
        "@hmcts/rpx-xui-common-lib",
        "@hmcts/rpx-xui-node-lib",
        "@hmcts/media-viewer",
        "rpx-xui-translation",
        "@microsoft/applicationinsights-web",
        "@opentelemetry/core",
        "applicationinsights",
        "/^@angular\\//",
        "/^@angular-devkit\\//"
      ],
      "enabled": false
    },
    {
      "description": "Disable major version updates",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
